{% extends '@AmzsCore/base.html.twig' %}
{% block title %}CMS- {% if article.id is null %}Add{% else %}Edit{% endif %} News Article{% endblock %}

{% block toolbar %}
    {% embed '@AmzsCore/Layout/_toolbar.html.twig' %}
        {% block toolbar_title %}{% if article.id is null %}Add{% else %}Edit{% endif %}{% endblock toolbar_title %}

        {% block toolbar_breadcrumbs %}
            <li class="breadcrumb-item text-muted">
                <a href="{{ path(constant('AmzsCMS\\ArticleBundle\\Constant\\ArticleRoute::ROUTE_INDEX')) }}" >
                    Articles
                </a>
            </li>
            <li class="breadcrumb-item">
                <span class="bullet bg-gray-500 w-5px h-2px"></span>
            </li>
            <li class="breadcrumb-item text-muted">News Article</li>
        {% endblock toolbar_breadcrumbs %}
    {% endembed %}
{% endblock %}

{% block body %}

    {% import '@AmzsArticle/article/partials/macros.html.twig' as macros %}
    {{ form_start(form, {attr: {
        class: "form d-flex flex-column flex-lg-row",
    }}) }}

    <div class="d-flex flex-column gap-7 gap-lg-10 w-100 w-lg-300px mb-7 me-lg-10">
        <div class="card card-flush py-4" data-gallery-target>
            <div class="card-header">
                <div class="card-title" >
                    <h2>Thumbnail</h2>
                </div>
                <div class="card-toolbar">
                    <a href="javascript:void(0)"
                       class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
                       data-amzs-gallery-modal
                       data-bs-toggle="tooltip"
                       title="Open Gallery">
                        <i class="ki-duotone ki-pencil fs-7">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </a>
                </div>
            </div>
            <div class="card-body text-center pt-0">
                <div class="image-input image-input-empty image-input-outline image-input-placeholder mb-3"
                     style="background-image: url('{{ asset(article.id is not null and article.thumbnail is not null ? article.thumbnail : 'themes/media/svg/files/blank-image.svg') }}');">
                    <div class="image-input-wrapper"></div>
                    {{ form_widget(form.thumbnail, {attr: {hidden: true}}) }}
                    <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="Cancel">
                        <i class="ki-duotone ki-cross fs-2">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </span>
                    <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" data-kt-image-input-action="remove" data-bs-toggle="tooltip" title="Remove">
                        <i class="ki-duotone ki-cross fs-2">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </span>
                </div>
                <div class="text-muted fs-7">Set the product thumbnail image. Only *.png, *.jpg and *.jpeg image files are accepted</div>
            </div>
        </div>

        <div class="card card-flush py-4">
            <div class="card-header">
                <div class="card-title">
                    <h2>Status</h2>
                </div>
                <div class="card-toolbar">
                    <div class="rounded-circle bg-success w-15px h-15px" data-Admin--article-add-target="dotStatus"></div>
                </div>
            </div>
            <div class="card-body pt-0">
                {{ form_widget(form.published, {attr: {'class': 'form-select fs-7', 'data-controller':'select2', 'data-Admin--article-add-target': 'status'}}) }}
                <div class="text-muted fs-7">Set the product status.</div>
            </div>
        </div>

        <div class="card card-flush py-4">
            <div class="card-header">
                <div class="card-title">
                    <h2>Page Details</h2>
                </div>
            </div>

            <div class="card-body pt-0">
                {% if form.category is defined %}
                    <div class="mb-10">
                        <label class="form-label d-block">Category</label>
                        {{ form_widget(form.category) }}
                        <div class="text-muted fs-7">Select category for this article.</div>
                    </div>
                {% endif %}
                <div class="mb-10">
                    <label class="form-label d-block">Topics</label>
                    {{ form_widget(form.topics) }}
                    <div class="text-muted fs-7">Select topics for this article.</div>
                </div>
                <label class="form-label d-block">Tags</label>
                {{ form_widget(form.arrTags, {attr: {class: 'js-tagify'}}) }}
                <div class="text-muted fs-7">Add tags to a page.</div>
            </div>
        </div>

        {% if article.id is not null %}
            <div class="card card-flush py-4">
                <div class="card-header">
                    <div class="card-title">
                        <h2>Page Config</h2>
                    </div>
                </div>
                <div class="card-body pt-0">
                    {{ macros.toggle('Keep slug', 'keep_slug', true, 'keep-slug' ) }}

                    {{ form_widget(form.isHot) }}
                    {{ form_widget(form.isNew) }}

                    <div class="mb-2"></div>
                    {{ macros.toggle('Hot', form.isHot.vars.full_name , article.isHot == 2, form.isHot.vars.id ) }}

                    <div class="mb-2"></div>
                    {{ macros.toggle('Lasted New', form.isNew.vars.full_name , article.isNew == 2, form.isNew.vars.id ) }}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="d-flex flex-column flex-row-fluid gap-7 gap-lg-10">

        {% if locales is defined and locales|length > 1 %}
            <div class="d-flex align-items-center gap-2" id="locale-switcher">
                <span class="text-muted fs-7 me-1">Language:</span>
                {% for locale in locales %}
                    <button type="button"
                            class="btn btn-sm {{ loop.first ? 'btn-primary' : 'btn-light' }} btn-locale"
                            data-locale="{{ locale }}">
                        {{ locale|upper }}
                    </button>
                {% endfor %}
            </div>
        {% endif %}

        <ul class="nav nav-custom nav-tabs nav-line-tabs nav-line-tabs-2x border-0 fs-4 fw-semibold mb-n2">
            <li class="nav-item">
                <a class="nav-link text-active-primary pb-4 active" data-bs-toggle="tab" href="#amz_article_general">General</a>
            </li>
            {% if article.id is not null %}
                <li class="nav-item">
                    <a class="nav-link text-active-primary pb-4" data-bs-toggle="tab" href="#amz_article_content">Content</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-active-primary pb-4" data-bs-toggle="tab" href="#amz_article_advanced">Advanced</a>
                </li>
            {% endif %}
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="amz_article_general" role="tab-panel">
                <div class="d-flex flex-column gap-7 gap-lg-10">
                    <div class="card card-flush py-4">
                        <div class="card-header">
                            <div class="card-title">
                                <h2>General</h2>
                            </div>
                        </div>
                        <div class="card-body pt-0">

                            {% for locale in locales %}
                                <div class="locale-fields" data-locale="{{ locale }}"
                                     {% if not loop.first %}style="display:none"{% endif %}>
                                    <div class="mb-10 fv-row">
                                        <label class="required form-label">
                                            Article Name
                                            {% if locales|length > 1 %}<span class="badge badge-light-primary ms-1">{{ locale|upper }}</span>{% endif %}
                                        </label>
                                        {{ form_widget(form['title_' ~ locale], {attr: {class: 'form-control mb-2'}}) }}
                                        <div class="text-muted fs-7">A page name is required and recommended to be unique.</div>
                                    </div>
                                    <div>
                                        <label class="form-label">
                                            Description
                                            {% if locales|length > 1 %}<span class="badge badge-light-primary ms-1">{{ locale|upper }}</span>{% endif %}
                                        </label>
                                        {{ form_widget(form['description_' ~ locale], {attr: {class: 'mb-2 form-control', rows: 5}}) }}
                                        <div class="text-muted fs-7">Set a description to the Page for better visibility.</div>
                                    </div>
                                </div>
                            {% endfor %}

                        </div>
                    </div>
                    {{ include('@AmzsArticle/article/social_sharing.html.twig') }}
                </div>
            </div>

            {% if article.id is not null %}
                <div class="tab-pane fade" id="amz_article_content" role="tab-panel">
                    {% for locale in locales %}
                        <div class="locale-fields" data-locale="{{ locale }}"
                             {% if not loop.first %}style="display:none"{% endif %}>
                            {{ form_widget(form['content_' ~ locale]) }}
                        </div>
                    {% endfor %}
                </div>

                <div class="tab-pane fade" id="amz_article_advanced" role="tab-panel">
                    <div class="d-flex flex-column gap-7 gap-lg-10">
                        <div class="card card-flush py-4">
                            <div class="card-header">
                                <div class="card-title">
                                    <h2>Gallery</h2>
                                </div>
                            </div>
                            <div class="card-body pt-0">
                                <div class="mb-10 fv-row">
                                    <label class="form-label">CSS</label>
                                    <div class="text-muted fs-7">Enter the css.</div>
                                </div>
                                <div class="mb-10 fv-row">
                                    <label class="form-label">Custom CSS</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="d-flex justify-content-end">
            <a href="{{ path(constant('AmzsCMS\\ArticleBundle\\Constant\\ArticleRoute::ROUTE_INDEX')) }}" class="btn btn-light me-5">Cancel</a>
            <button type="button"
                    class="btn btn-primary"
                    id="bnt-submit"
                    data-route="{% if article.id is null %}
                        {{ path(constant('AmzsCMS\\ArticleBundle\\Constant\\ArticleRoute::ROUTE_ADD')) }}
                    {% else %}
                        {{ path(constant('AmzsCMS\\ArticleBundle\\Constant\\ArticleRoute::ROUTE_EDIT'), {id: article.id}) }}
                    {% endif %}">
                <span class="indicator-label">Save Changes</span>
                <span class="indicator-progress">Please wait...
                   <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
            </button>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <script>
        $(function () {
            $('.js-select2-topics').select2({
                placeholder: '-- Chọn chủ đề --',
                allowClear: true,
                width: '250',
                closeOnSelect: false,
            });
        });
    </script>
    <script src="{{ asset(get_path_article_cms_asset() ~ 'assets/js/article.js') }}"></script>
{% endblock %}